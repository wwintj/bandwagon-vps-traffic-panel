# Web 服務配置
HOST=127.0.0.1
PORT=8088

# 面板安全認證 (部署時務必修改為強密碼)
# 允許的字元：大小寫字母、數字、@ _ - . ! %
# 密碼留空時面板會拒絕所有登入
AUTH_USERNAME=admin
AUTH_PASSWORD=your_secure_password

# 面板文案
PANEL_TITLE="VPS 監控流量面板"
PANEL_SUBTITLE="Tim哥在三更半夜改好的"

# Telegram 推送
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUSH_HOUR=20
TELEGRAM_PUSH_MINUTE=0
# 面板時區（UTC 偏移小時）：今日 / 本期統計、圖表與推送都按此時區
TELEGRAM_TIMEZONE_OFFSET=8
TELEGRAM_TIMEZONE_LABEL=中國時間
BANDWAGON_VEID=
BANDWAGON_API_KEY=
TRAFFIC_QUOTA_BYTES=0
# 流量預警：用量達門檻（%）時發 Telegram 提醒，每個計費週期每檔只提醒一次
TRAFFIC_ALERT_ENABLED=1
TRAFFIC_ALERT_THRESHOLDS=80,90,100
# VPS 到期日（YYYY-MM-DD）。搬瓦工 API 不提供，請手動填寫，續費後更新
VPS_EXPIRY_DATE=
CLOUDFLARE_DDNS_ENABLED=0
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_RECORD_NAME=
CLOUDFLARE_PROXIED=0
# DDNS 檢查間隔（分鐘，1-60）、TTL（1 為自動，或 60-86400 秒）、IP 變更 / 失敗時發 Telegram 通知
CLOUDFLARE_DDNS_INTERVAL=5
CLOUDFLARE_TTL=1
CLOUDFLARE_DDNS_NOTIFY=1

# 監控網卡 (留空則自動偵測預設網卡)
INTERFACE=

# 每月流量重置日 (1-31，預設每月 1 日)
MONTH_RESET_DAY=1

# SSL 憑證配置 (安裝腳本偵測到 Let's Encrypt 憑證並啟用 HTTPS 時自動寫入)
SSL_ENABLED=0
SSL_CERTFILE=
SSL_KEYFILE=
HTTPS_MODE=none
PANEL_DOMAIN=
